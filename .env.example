# --- Frontend (Vite) — set in Vercel “Environment Variables” and redeploy (baked in at build) ---
# Public URL of your API (no trailing slash). On Vercel this MUST be set to your hosted API
# (e.g. https://your-api.onrender.com) or the live site cannot load slots or process payments.
VITE_API_BASE=
# Never put SQUARE_ACCESS_TOKEN here — it belongs only on the API server. Redeploy after changing.
VITE_SQUARE_APPLICATION_ID=
VITE_SQUARE_LOCATION_ID=
# sandbox = sandbox web SDK; production = live (must match Application ID and token environment)
VITE_SQUARE_ENVIRONMENT=sandbox

# --- API server (host on Railway, Render, Fly.io, etc. — not on Vercel static) ---
PORT=3001
CORS_ORIGIN=https://your-site.vercel.app
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
SQUARE_LOCATION_ID=
DATABASE_PATH=./data/appointments.sqlite
