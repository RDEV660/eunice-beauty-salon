# --- Frontend (Vite) — set in Vercel “Environment Variables” ---
# Public URL of your API (no trailing slash). Leave empty for same-origin (local dev proxy only).
VITE_API_BASE=

# --- API server (host on Railway, Render, Fly.io, etc. — not on Vercel static) ---
PORT=3001
CORS_ORIGIN=https://your-site.vercel.app
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
SQUARE_LOCATION_ID=
DATABASE_PATH=./data/appointments.sqlite
