# --- Frontend (Vite) — set in Vercel “Environment Variables” and redeploy (baked in at build) ---
# Public URL of your API (no trailing slash). Leave empty on Vercel if API is deployed
# in the same project (see api/index.ts + vercel.json rewrites to /api).
# If the API is on another host (e.g. Render), set: https://your-api.onrender.com
VITE_API_BASE=
# Never put SQUARE_ACCESS_TOKEN here — it belongs only on the API server. Redeploy after changing.
VITE_SQUARE_APPLICATION_ID=
VITE_SQUARE_LOCATION_ID=
# sandbox = sandbox web SDK; production = live (must match Application ID and token environment)
VITE_SQUARE_ENVIRONMENT=sandbox
# In sandbox, use Square test card data only. Real credit cards are always rejected (HTTP 400 on card-nonce).
# --- Go live (production Square) ---
# 1) In Square Dashboard, create a Production application (not sandbox), copy Application ID, Location ID, and
#    create a Production access token (keep it server-only, never in Vite).
# 2) Frontend (Vite build): VITE_SQUARE_ENVIRONMENT=production, VITE_SQUARE_APPLICATION_ID=<prod app id>,
#    VITE_SQUARE_LOCATION_ID=<prod location id> — the Application ID must not contain "sandbox".
# 3) API host: SQUARE_ENVIRONMENT=production, SQUARE_ACCESS_TOKEN=<prod token>, SQUARE_LOCATION_ID if used server-side.
# 4) Redeploy the site and the API so both pick up the new env vars. Test with a real small charge if needed.
# See: https://developer.squareup.com/docs/devtools/sandbox/payments

# --- API server (host on Railway, Render, Fly.io, etc. — not on Vercel static) ---
PORT=3001
CORS_ORIGIN=https://your-site.vercel.app
# Staff-only: /admin/availability (Bearer token on API). Set a long random string; add to the same Vercel project as env for serverless or your Node host.
ADMIN_PASSWORD=
SQUARE_ACCESS_TOKEN=
SQUARE_ENVIRONMENT=sandbox
SQUARE_LOCATION_ID=
# Used in payment note / appointment time text (default America/Chicago for Texas)
BUSINESS_TIMEZONE=America/Chicago

# Square Dashboard: turn on payment / order alerts (email or push) so you see new deposits.
# https://squareup.com/help/us/en/article/8025-set-up-and-manage-alerts (path may vary — search “Square notifications” in Help)
DATABASE_PATH=./data/appointments.sqlite
